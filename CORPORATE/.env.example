# FRED API key — required by the CORPORATE/ credit curves (free, read-only).
#
# Setup:
#   1. Get a free key:  https://fredaccount.stlouisfed.org/apikeys
#   2. Copy this file:  cp .env.example .env
#   3. Paste your key below (32-char lowercase alphanumeric).
#
# The real .env is gitignored and never committed. If FRED is unreachable,
# credit_curves.py falls back to manual spreads, so the key is not strictly
# required to see the pipeline run.

FRED_API_KEY=
